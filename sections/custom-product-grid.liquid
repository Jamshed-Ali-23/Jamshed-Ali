{% schema %}
{
  "name": "Custom Product Grid",
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "selected_product",
          "label": "Choose Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}

<div class="custom-grid-container">
  {% for block in section.blocks %}
    {% assign product = all_products[block.settings.selected_product] %}
    {% if product != empty %}
      <div class="grid-item">
        <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
        <h3>{{ product.title }}</h3>
        
        <button class="popup-trigger" onclick="openPopup({{ product.id }})">
          <svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="red"/></svg>
        </button>

        <div id="data-{{ product.id }}" class="product-data-hidden" style="display:none;">
          <input type="hidden" class="p-id" value="{{ product.id }}">
          <input type="hidden" class="p-title" value="{{ product.title }}">
          <input type="hidden" class="p-price" value="{{ product.price | money }}">
          <input type="hidden" class="p-desc" value="{{ product.description | strip_html | truncate: 100 }}">
          <input type="hidden" class="p-image" value="{{ product.featured_image | image_url: width: 600 }}">
          
          <script type="application/json" class="p-variants">
            {{ product.variants | json }}
          </script>
          <script type="application/json" class="p-options">
            {{ product.options_with_values | json }}
          </script>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<div id="productPopup" class="custom-popup-overlay" style="display:none;">
  <div class="custom-popup-content">
    <button class="close-btn" onclick="closePopup()">X</button>
    <div class="popup-flex">
      <div class="popup-img">
        <img id="modalImage" src="" alt="">
      </div>
      <div class="popup-details">
        <h2 id="modalTitle"></h2>
        <p id="modalPrice"></p>
        <p id="modalDesc"></p>
        
        <form id="addToCartForm">
          <div id="modalVariants"></div> <input type="hidden" name="id" id="modalVariantId">
          <button type="button" id="addToCartBtn">ADD TO CART</button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  /* GRID CSS - Adjust based on Figma */
  .custom-grid-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 20px;
  }
  .grid-item {
    position: relative;
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
  }
  .popup-trigger {
    position: absolute;
    bottom: 10px;
    right: 10px;
    cursor: pointer;
    background: none;
    border: none;
  }
  
  /* POPUP CSS */
  .custom-popup-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
  }
  .custom-popup-content {
    background: white;
    padding: 20px;
    width: 80%;
    max-width: 800px;
    display: flex;
    position: relative;
  }
  .popup-flex { display: flex; gap: 20px; width: 100%; }
  .popup-img { width: 50%; }
  .popup-details { width: 50%; }
  .close-btn { position: absolute; top: 10px; right: 10px; }
  
  @media(max-width: 768px) {
    .custom-grid-container { grid-template-columns: 1fr; } /* Mobile View */
    .popup-flex { flex-direction: column; }
    .popup-img, .popup-details { width: 100%; }
  }
</style>

<script>
  let currentVariants = [];

  function openPopup(productId) {
    const dataDiv = document.getElementById(`data-${productId}`);
    if(!dataDiv) return;

    // Fill Basic Info
    document.getElementById('modalTitle').innerText = dataDiv.querySelector('.p-title').value;
    document.getElementById('modalPrice').innerText = dataDiv.querySelector('.p-price').value;
    document.getElementById('modalDesc').innerText = dataDiv.querySelector('.p-desc').value;
    document.getElementById('modalImage').src = dataDiv.querySelector('.p-image').value;

    // Build Variant Selectors
    const options = JSON.parse(dataDiv.querySelector('.p-options').innerHTML);
    currentVariants = JSON.parse(dataDiv.querySelector('.p-variants').innerHTML);
    
    const container = document.getElementById('modalVariants');
    container.innerHTML = ''; // Clear previous

    options.forEach((opt, index) => {
      const label = document.createElement('label');
      label.innerText = opt.name;
      const select = document.createElement('select');
      select.className = 'variant-selector';
      select.dataset.index = index; // Option 1, 2, or 3
      select.onchange = updateSelectedVariant;
      
      opt.values.forEach(val => {
        const option = document.createElement('option');
        option.value = val;
        option.innerText = val;
        select.appendChild(option);
      });
      
      container.appendChild(label);
      container.appendChild(select);
    });

    updateSelectedVariant(); // Set initial state
    document.getElementById('productPopup').style.display = 'flex';
  }

  function closePopup() {
    document.getElementById('productPopup').style.display = 'none';
  }

  function updateSelectedVariant() {
    // Get all current selects
    const selects = document.querySelectorAll('.variant-selector');
    const selectedOptions = Array.from(selects).map(s => s.value);

    // Find matching variant
    const matchedVariant = currentVariants.find(v => {
      // Option1, Option2, Option3 check
      let match = true;
      if(selectedOptions[0] && v.option1 !== selectedOptions[0]) match = false;
      if(selectedOptions[1] && v.option2 !== selectedOptions[1]) match = false;
      if(selectedOptions[2] && v.option3 !== selectedOptions[2]) match = false;
      return match;
    });

    const btn = document.getElementById('addToCartBtn');
    const idInput = document.getElementById('modalVariantId');

    if(matchedVariant && matchedVariant.available) {
      idInput.value = matchedVariant.id;
      btn.disabled = false;
      btn.innerText = 'ADD TO CART';
      document.getElementById('modalPrice').innerText =  (matchedVariant.price / 100).toFixed(2);
    } else {
      btn.disabled = true;
      btn.innerText = 'Unavailable';
    }
  }

  // LOGIC: Add to Cart + Bonus Product (Black & Medium)
  document.getElementById('addToCartBtn').addEventListener('click', function() {
    const variantId = document.getElementById('modalVariantId').value;
    const selects = document.querySelectorAll('.variant-selector');
    
    // Check Logic: Black AND Medium
    let isBlack = false;
    let isMedium = false;

    selects.forEach(s => {
      if(s.value.toLowerCase() === 'black') isBlack = true;
      if(s.value.toLowerCase() === 'medium') isMedium = true;
    });

    let items = [{ id: variantId, quantity: 1 }];

    // *** IMPORTANT: REPLACE '123456789' WITH THE REAL ID OF SOFT WINTER JACKET ***
    const bonusProductId = '123456789'; 

    if(isBlack && isMedium) {
      items.push({ id: bonusProductId, quantity: 1 });
      console.log("Bonus item added!");
    }

    // Shopify AJAX API (Vanilla JS)
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(response => {
      return response.json();
    })
    .then(data => {
      alert('Added to cart!');
      closePopup();
      // Optional: Refresh cart bubble here
    })
    .catch((error) => {
      console.error('Error:', error);
      alert('Error adding to cart');
    });
  });
</script>