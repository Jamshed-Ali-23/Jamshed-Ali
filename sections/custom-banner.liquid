{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Welcome to Our Store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "Shop the latest trends"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<div class="custom-banner" style="background-image: url('{{ section.settings.banner_image | image_url: width: 1600 }}');">
  <div class="banner-content">
    <h1 class="editable-text">{{ section.settings.heading }}</h1>
    <p class="editable-text">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.btn_link }}" class="banner-btn">{{ section.settings.btn_text }}</a>
  </div>
</div>

<style>
  .custom-banner {
    height: 500px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .banner-content {
    text-align: center;
    color: white;
  }
  .banner-btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: #000;
    color: #fff;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .banner-btn:hover {
    transform: scale(1.1);
  }
  
  @media(max-width: 768px) {
    .custom-banner {
      height: 300px;
    }
  }
</style>